prefix=/home/b/.warptempo/warptempo_gui/android/prebuilt/arm64-v8a
includedir=${prefix}/include
libdir=${prefix}/lib

Name: cairo
Description: Multi-platform 2D graphics library
Version: 1.18.4
Requires: freetype2 >=  23.0.17, pixman-1 >=  0.40.0
Libs: -L${libdir} -lcairo -lm -ldl
Cflags: -I${includedir}/cairo
