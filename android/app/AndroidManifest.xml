<?xml version="1.0" encoding="utf-8"?>
<!-- warptempo_gui, the product APK. A NativeActivity over libwarptempo_gui.so,
     whose android_main (src/gui/platform_android.cpp) calls the same gui_main
     the desktop main() calls.

     hasCode="true" since the Java sliver: the APK carries a classes.dex
     holding exactly ONE class, .MainActivity (a NativeActivity subclass), and
     build_apk.sh grew a javac -> d8 step for it. It makes the window FULL
     SCREEN — both system bars hidden, sticky immersive (architect 2026-10-01;
     the rule is at the class's head) — so the native surface, which is the
     whole panel whatever this or the theme says, is the window the Android
     backend hands the GUI whole (src/gui/platform_android.cpp). The port's
     other Java needs join THAT class as methods: the car's MediaSession and
     the system clipboard have; SAF's onActivityResult would.

     Not the spike's package: com.warptempo.gui is the product's own name, so
     installing or removing either one leaves the other alone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.warptempo.gui">

  <!-- THE HISTORY VIEW'S GIT TALKS TO GITHUB (src/gui/git_repo.cpp: libgit2
       over SSH with the device's deploy key). Without this permission the
       app's process is not in the inet group: socket(AF_INET) fails with
       EACCES and DNS is refused, so every network step git takes would fail
       before reaching GitHub. A normal permission, granted at install and on
       an update install; nothing to grant by hand. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- The OTG stick is M6's, and a device without one must still install. -->
  <uses-feature android:name="android.hardware.usb.host" android:required="false" />

  <!-- android:icon is the launcher and recents icon: Chicago95's
       status/audio-volume-high.png (architect 2026-10-05, the icon pass's
       caption pick — the caption's own picture at a bitmap gui_scale too),
       scaled nearest-neighbour onto a transparent adaptive-icon canvas
       (res/mipmap-anydpi-v26/ic_launcher.xml holds the recipe). The Linux
       desktop's launcher icon (packaging/warptempo_gui.svg) is the same
       picture, one rect per pixel (tools/desktop_icon/gen_desktop_icon.py). -->
  <application
      android:label="Warptempo"
      android:icon="@mipmap/ic_launcher"
      android:hasCode="true"
      android:extractNativeLibs="false"
      android:allowBackup="false"
      android:debuggable="true">

    <!-- The subclass, not android.app.NativeActivity: it is what hides the
         system bars. android.app.lib_name stays here on the
         <activity> — NativeActivity's own onCreate reads it and dlopens the
         library exactly as before, so the native side is unaware this class
         exists. Component name: com.warptempo.gui/.MainActivity

         Theme.NoTitleBar: no title bar, because an app of this kind carries
         none. Not .Fullscreen: that theme's FLAG_FULLSCREEN hides the status
         bar alone and non-sticky, while the class hides BOTH bars sticky
         through the window's insets controller at create and at every focus
         gain (architect 2026-10-01), which is the one owner of the bars.

         No windowLayoutInDisplayCutoutMode: the default never lays a landscape
         window into a cutout, and this panel has none anyway.

         screenOrientation="sensorLandscape": THE SENSOR DECIDES, BUT ALWAYS
         LANDSCAPE, NEVER PORTRAIT. The lock is landscape-ONLY, not one
         landscape — the tablet is held with its USB-C port on either side and
         the product is upright for both — and a 180° flip keeps the window's
         size, moving nothing but the surface's transform, which the compositor
         owns. So resizeableActivity="false" still buys the one geometry;
         orientation|screenSize are in configChanges so the flip never recreates
         the activity, and screenSize|screenLayout are there so a configuration
         change never recreates it either.

         colorMode="wideColorGamut": THE WINDOW IS A DISPLAY-P3 LAYER
         (architect 2026-10-02). Without it the window is colour-space
         agnostic and the compositor treats every buffer as sRGB whatever it
         is tagged; with it the compositor and the display hardware honour the
         buffers' dataspace, which GuiPlatform::adopt_window
         (src/gui/platform_android.cpp) tags DISPLAY_P3, so the panel receives
         the app as it receives a gallery viewer's P3-tagged image. The rule
         and its measurement are at that call and that file's head. -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:label="Warptempo"
        android:theme="@android:style/Theme.NoTitleBar"
        android:screenOrientation="sensorLandscape"
        android:resizeableActivity="false"
        android:launchMode="singleTask"
        android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode|navigation|keyboard"
        android:windowSoftInputMode="adjustNothing"
        android:colorMode="wideColorGamut">

      <!-- soname without the lib prefix and the .so suffix. -->
      <meta-data android:name="android.app.lib_name" android:value="warptempo_gui" />

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
