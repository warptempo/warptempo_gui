<?xml version="1.0" encoding="utf-8"?>
<!-- warptempo_gui, the product APK. A NativeActivity over libwarptempo_gui.so,
     whose android_main (src/gui/platform_android.cpp) calls the same gui_main
     the desktop main() calls.

     hasCode="true" since the Java sliver: the APK carries a classes.dex
     holding exactly ONE class, .MainActivity (a NativeActivity subclass), and
     build_apk.sh grew a javac -> d8 step for it. Its body is
     setDecorFitsSystemWindows(true) plus the status bar's colour — Java-only,
     and the first of them ASKS rather than wins:
     the native surface is the whole panel whatever this or the theme says, and
     what the call plus targetSdk 34 actually buy is the framework reporting a
     real CONTENT RECT — the band inside the system bars, which the Android
     backend then makes the window (src/gui/platform_android.cpp;
     android/toolchain/00_env.sh owns the target and its reasoning). Without it
     the product paints under the taskbar, whose INPUT it owns across the whole
     bottom row. The port's other Java needs (SAF's
     onActivityResult, the system clipboard, the key-repeat cadence) join THAT
     class as methods.

     Not the spike's package: com.warptempo.gui is the product's own name, so
     installing or removing either one leaves the other alone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.warptempo.gui">

  <!-- DECLARED FOR M6, granted by hand in Settings, and unused until then. The
       source and its three sidecars live in the app's own external files dir
       (/sdcard/Android/data/com.warptempo.gui/files), which needs no permission
       at all; All-files access is what the OTG / arbitrary-folder arc will
       need, and declaring it now keeps the manifest stable across that landing. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

  <!-- The OTG stick is M6's, and a device without one must still install. -->
  <uses-feature android:name="android.hardware.usb.host" android:required="false" />

  <application
      android:label="Warptempo"
      android:hasCode="true"
      android:extractNativeLibs="false"
      android:allowBackup="false"
      android:debuggable="true">

    <!-- The subclass, not android.app.NativeActivity: it is what puts the
         window inside the system bars. android.app.lib_name stays here on the
         <activity> — NativeActivity's own onCreate reads it and dlopens the
         library exactly as before, so the native side is unaware this class
         exists. Component name: com.warptempo.gui/.MainActivity

         Theme.NoTitleBar, not .Fullscreen: the status bar and the taskbar SHOW
         (architect 2026-08-27, retiring immersive mode), and no title bar
         because an app of this kind carries none — the STATUS bar is this
         window's title bar and MainActivity paints it the product's row ground
         (which is why that class also sets FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS
         by hand: this legacy theme does not), while the taskbar's colors stay
         the system's.

         No windowLayoutInDisplayCutoutMode: the default never lays a landscape
         window into a cutout, and this panel has none anyway. resizeableActivity="false" with the
         landscape lock keeps the one geometry; screenSize|screenLayout are in
         configChanges so a bar coming or going resizes the window instead of
         recreating the activity. -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:label="Warptempo"
        android:theme="@android:style/Theme.NoTitleBar"
        android:screenOrientation="landscape"
        android:resizeableActivity="false"
        android:launchMode="singleTask"
        android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode|navigation|keyboard"
        android:windowSoftInputMode="adjustNothing">

      <!-- soname without the lib prefix and the .so suffix. -->
      <meta-data android:name="android.app.lib_name" android:value="warptempo_gui" />

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
